# --- Database (Neon PostgreSQL) ---
# Get this from your Neon project dashboard. Use the "pooled" connection string.
DATABASE_URL="DATABASE_URL="postgresql://neondb_owner:npg_O3lAuak2DSwh@ep-gentle-resonance-axjiz56g.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require""

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL="http://localhost:3000"

# --- AI Provider (Anthropic) ---
AI_PROVIDER="anthropic"
AI_PROVIDER_API_KEY=
AI_TEXT_MODEL="claude-sonnet-4-5-20250929"
AI_MAX_TOKENS=8000
AI_TEMPERATURE=0.2

# --- Generation limits ---
MAX_GENERATED_FILES=40
MAX_FILE_SIZE=250000
MAX_GENERATION_TIME=300000
MAX_AI_RETRIES=2
MAX_VALIDATION_RETRIES=3

# --- Uploads ---
MAX_REFERENCE_FILE_SIZE=5242880

# --- Storage mode ---
# database = files persisted as rows in Postgres (default, no extra setup)
# This build always uses "database" mode. Object storage (S3/R2) can be added later.
STORAGE_MODE=database

# --- Jobs ---
# inline = generation runs synchronously in the API request (no worker/queue needed)
JOB_MODE=inline
